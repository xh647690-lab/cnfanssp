---
import { copy, origin, catalog } from '../copy.js';
import { faqs, guides } from '../editorial.js';
const navText = {
  en: ['Home', 'Categories', 'FAQ', 'Guides', 'English', 'Read the guide', 'Sources'],
  de: ['Startseite', 'Kategorien', 'FAQ', 'Ratgeber', 'Englisch', 'Ratgeber lesen', 'Quellen'],
  es: ['Inicio', 'Categorías', 'Preguntas frecuentes', 'Guías', 'Inglés', 'Leer la guía', 'Fuentes'],
  fr: ['Accueil', 'Catégories', 'FAQ', 'Guides', 'Anglais', 'Lire le guide', 'Sources'],
  zh: ['首页', '商品分类', '常见问题', '选购指南', '英文', '阅读指南', '参考来源'],
};
export function getStaticPaths() {
  const routes = ['', 'categories', 'faq', 'guides', ...guides.map(([slug]) => 'guides/' + slug)];
  return Object.keys(copy).flatMap(lang => routes.map(route => ({
    params: { lang: [lang === 'en' ? '' : lang, route].filter(Boolean).join('/') || undefined },
    props: { lang, route },
  })));
}
const { lang, route } = Astro.props;
const [, , description, placeholder, search, categories, latest, all, signUp, buy, unavailable, detail, language] = copy[lang];
const [homeText, categoryText, faqText, guideText, englishText, readGuide, sources] = navText[lang];
const path = (code, target = '') => '/' + [code === 'en' ? '' : code, target].filter(Boolean).map(part => part + '/').join('');
const local = (target = '') => path(lang, target);
const article = guides.find(([slug]) => route === 'guides/' + slug);
const heading = article?.[1] ?? ({faq: faqText, guides: guideText, categories: categoryText}[route] || 'Litbuy Spreadsheet');
const isHome = !route;
---
<html lang={lang === 'zh' ? 'zh-CN' : lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="canonical" href={'https://litbuysheet.food' + path(route && route !== 'categories' ? 'en' : lang, route)}>
  <title>{isHome ? 'Litbuy Spreadsheet | Shop Finds, Product Links & QC Guides' : heading + ' | Litbuy Spreadsheet'}</title>
  <meta name="description" content={article?.[2] ?? description}>
  <link rel="icon" type="image/png" href="https://litbuy.com/favicon-new.ico">
  {Object.keys(copy).map(code => <link rel="alternate" hreflang={code === 'zh' ? 'zh-CN' : code} href={'https://litbuysheet.food' + path(code, route)} />)}
  <link rel="alternate" hreflang="x-default" href={'https://litbuysheet.food' + path('en', route)}>
</head>
<body>
<header class="top">
  <div class="wrap bar">
    <a class="brand" href={local()} aria-label="Litbuy Spreadsheet"><img src="https://litbuy.com/static/logo.png" alt="Litbuy" width="127" height="33"></a>
    <nav class="main-nav" aria-label={homeText}>
      {[['', homeText], ['categories', categoryText], ['faq', faqText], ['guides', guideText]].map(([target, label]) => <a href={local(target)} aria-current={route === target || (target === 'guides' && article) ? 'page' : undefined}>{label}</a>)}
    </nav>
    <div class="tools">
      <details>
        <summary aria-label={language}>{copy[lang][0]} {lang.toUpperCase()}</summary>
        <div class="languages">
          {Object.entries(copy).map(([code, labels]) => <a href={path(code, route)} hreflang={code} aria-current={code === lang ? 'page' : undefined}>{labels[0]} <small>{code.toUpperCase()}</small></a>)}
        </div>
      </details>
      <a class="button join" href="https://litbuy.com/register">{signUp}</a>
    </div>
  </div>
</header>
<main class="wrap">
{isHome ? <>
  <section class="hero">
    <div>
      <h1>Litbuy <em>Spreadsheet</em></h1>
      <p>{description}</p>
      <form action={origin + '/search.html'} method="get" role="search">
        <input type="search" aria-label={placeholder} name="keywords" placeholder={placeholder} maxlength="200" required>
        <input type="hidden" name="channelid" value="2">
        <button>{search}</button>
      </form>
    </div>
    <aside class="featured" data-buy={buy} data-detail={detail}><span id="featured-slot"></span></aside>
  </section>
  <section class="section categories" aria-labelledby="categories">
    <div class="section-head"><h2 id="categories">{categories}</h2><a href={local('categories')}>{categoryText}</a></div>
    <div class="chips"><span id="categories-slot"></span></div>
  </section>
  <section class="section" aria-labelledby="latest">
    <div class="section-head"><h2 id="latest">{latest}</h2><a href={catalog}>{all}</a></div>
    <div class="grid" data-detail={detail} data-unavailable={unavailable}><span id="products-slot"></span></div>
  </section>
  <div class="editorial-home">
    <section><div class="section-head"><h2><a href={local('faq')}>{faqText}</a></h2></div>
      <div class="teasers" lang="en">{faqs.slice(-3).reverse().map(([id, question]) => <a href={local('faq') + '#' + id}>{question}</a>)}</div>
    </section>
    <section><div class="section-head"><h2><a href={local('guides')}>{guideText}</a></h2></div>
      <div class="teasers" lang="en">{guides.slice(-3).reverse().map(([slug, name]) => <a href={local('guides/' + slug)}>{name}</a>)}</div>
    </section>
  </div>
</> : route === 'categories' ? <section class="inner">
  <h1>{heading}</h1>
  <div class="chips category-list"><span id="categories-slot"></span></div>
  <a class="button" href={catalog}>{all}</a>
</section> : route === 'faq' ? <section class="inner">
  <h1>{heading}</h1>
  {lang !== 'en' && <p class="language-note">{englishText}</p>}
  <div class="faq" lang="en">
    {faqs.map(([id, question, answer, guide]) => <details id={id} name="faq"><summary>{question}</summary><p>{answer} <a href={local('guides/' + guides[guide][0])}>{readGuide}</a></p></details>)}
  </div>
  <script is:inline>
    function revealQuestion() {
      const question = document.getElementById(location.hash.slice(1));
      if (question instanceof HTMLDetailsElement) question.open = true;
    }
    revealQuestion();
    window.addEventListener('hashchange', revealQuestion);
  </script>
</section> : article ? <article class="inner article" lang="en">
  <a class="back" href={local('guides')}>{guideText}</a>
  <h1>{heading}</h1>
  <p class="intro">{article[2]}</p>
  {article[3].map(([subtitle, paragraph]) => <section><h2>{subtitle}</h2><p>{paragraph}</p></section>)}
  <section><h2>{sources}</h2><ul>{article[4].map(([url, label]) => <li><a href={url}>{label}</a></li>)}</ul></section>
</article> : <section class="inner">
  <h1>{heading}</h1>
  {lang !== 'en' && <p class="language-note">{englishText}</p>}
  <div class="guide-index" lang="en">
    {guides.map(([slug, name, intro]) => <a href={local('guides/' + slug)}><strong>{name}</strong><span>{intro}</span></a>)}
  </div>
</section>}
</main>
<footer><div class="wrap"><a href={origin}>CNFansSP</a><span>Litbuy Spreadsheet</span></div></footer>
</body>
</html>
<style is:global>
  :root{color-scheme:light;--ink:#191919;--muted:#555;--accent:#f5cc00;--line:#e7e4da;--paper:#faf9f5}
  *{box-sizing:border-box}body{margin:0;color:var(--ink);background:var(--paper);font:16px/1.55 system-ui,sans-serif}
  a{color:inherit;text-decoration:none}a:hover{text-decoration:underline}button,summary{cursor:pointer}
  :focus-visible{outline:3px solid #239770;outline-offset:3px}
  .wrap{width:min(1180px,calc(100% - 48px));margin:auto}
  .top{background:#fff;border-bottom:1px solid var(--line)}.bar{min-height:72px;display:flex;align-items:center;justify-content:space-between;gap:16px}
  .brand{display:flex;align-items:center;gap:10px;font-weight:750}.brand span{display:grid;place-items:center;width:34px;height:34px;border-radius:9px;background:var(--ink);color:#fff}
  nav{display:flex;align-items:center;gap:18px}details{position:relative}summary{font-size:.9rem;white-space:nowrap}
  .languages{position:absolute;right:0;z-index:2;top:34px;min-width:145px;display:grid;padding:6px;background:#fff;border:1px solid var(--line);border-radius:12px;box-shadow:0 12px 24px #133c2220}.languages a{padding:7px 10px}.languages [aria-current]{font-weight:750;color:#745700}
  .button,button{display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:9px;padding:10px 15px;background:var(--accent);color:#171717;font:inherit;font-weight:650}
  .hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(230px,310px);align-items:center;gap:40px;margin-top:36px;padding:clamp(24px,5vw,58px);background:#fff1a8;border:1px solid #f2dc6e;border-radius:24px}
  h1,h2,h3,p{margin:0}h1{font-size:clamp(2.15rem,5.8vw,4.5rem);line-height:1.02;letter-spacing:-.055em}h2{font-size:clamp(1.3rem,3vw,1.85rem);letter-spacing:-.03em}.hero p{margin:15px 0 24px;color:var(--muted);max-width:46ch}
  form{max-width:580px;display:flex;gap:8px;padding:6px;background:#fff;border:1px solid var(--line);border-radius:12px}input[type=search]{min-width:0;width:100%;padding:8px 10px;border:0;font:inherit;color:var(--ink);background:transparent}
  .featured{background:#fff;border:1px solid var(--line);border-radius:16px;padding:16px}.featured:has(> #featured-slot),.categories:has(#categories-slot){display:none}
  .featured img{display:block;width:100%;height:150px;object-fit:contain;background:var(--paper);border-radius:9px;margin-bottom:10px}.featured .button{margin-top:12px}.id{color:var(--muted);font-size:.875rem}
  .section{margin:30px 0}.section-head{display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin-bottom:14px}.section-head a{color:#745700;font-weight:650;text-align:right}
  .chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.chips a{background:#fff;border:1px solid var(--line);padding:7px 12px;border-radius:999px;font-size:.9rem}
  .grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.grid>p{grid-column:1/-1}.card{overflow:hidden;background:#fff;border:1px solid var(--line);border-radius:14px}.card img{display:block;width:100%;aspect-ratio:1.4;object-fit:contain;background:#eef2ee}.card div{display:grid;gap:3px;padding:11px}.card small{color:#745700;font-size:.875rem}
  footer{border-top:1px solid var(--line);background:#fff;color:var(--muted);padding:20px 0}footer .wrap{display:flex;justify-content:space-between;gap:12px}
  @media(max-width:730px){.wrap{width:calc(100% - 28px)}.hero{grid-template-columns:1fr;gap:16px;margin-top:20px}.featured img{height:110px}.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.bar{flex-wrap:wrap;padding:10px 0}nav{gap:10px}.join{font-size:.875rem}}

  .brand img{width:127px;height:auto}.tools,.main-nav{display:flex;align-items:center;gap:16px}.main-nav a{font-size:.94rem;font-weight:650}.main-nav [aria-current]{text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:6px}.hero em{font-style:normal}
  .editorial-home{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:32px 0}.teasers{display:grid;gap:8px}.teasers a,.guide-index a{padding:12px 14px;background:#fff;border:1px solid var(--line);border-radius:10px}.teasers a{font-weight:650}
  .inner{max-width:800px;margin:32px auto}.inner h1{font-size:clamp(2rem,6vw,3.2rem);line-height:1.1;margin:8px 0 18px}.language-note{color:var(--muted);margin-bottom:10px}.category-list{margin-bottom:20px}
  .faq{border-top:1px solid var(--line)}.faq details{border-bottom:1px solid var(--line)}.faq summary{white-space:normal;font-weight:650;padding:11px 0}.faq p{margin:0 0 12px 16px}.faq a,.article a{text-decoration:underline;text-underline-offset:3px}
  .guide-index{display:grid;grid-template-columns:1fr 1fr;gap:9px}.guide-index a{display:grid;gap:3px}.guide-index span,.intro{color:var(--muted)}.article{max-width:720px}.article section{margin-top:20px}.article h2{font-size:1.25rem;margin-bottom:4px}.article ul{padding-left:22px}.back{font-weight:650}
  @media(max-width:730px){.main-nav{width:100%;order:3;gap:16px;flex-wrap:wrap}.tools{gap:8px}.brand img{width:92px}.join{padding:8px}.editorial-home,.guide-index{grid-template-columns:1fr}.grid .card:nth-child(n+5){display:none}.inner{margin:22px auto}.guide-index a{padding:9px 12px}.guide-index span{font-size:.875rem}.teasers a{padding:9px 12px}}
</style>
