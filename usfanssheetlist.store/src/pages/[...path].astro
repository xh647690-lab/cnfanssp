---
import { articles, faq } from "../editorial.js";

const locales = {
  en: ['English', 'Browse catalog', 'Join USFans', 'Find products to order with USFans.', 'Browse the live CNFansSP catalog and open product details at the source.', 'Search products', 'Search', 'Categories', 'Latest products', 'Open full catalog', 'Loading catalog…', 'The live catalog is temporarily unavailable.'],
  de: ['Deutsch', 'Katalog ansehen', 'Bei USFans anmelden', 'Finde Produkte für deine USFans-Bestellung.', 'Durchsuche den aktuellen CNFansSP-Katalog und öffne Produktdetails an der Quelle.', 'Produkte suchen', 'Suchen', 'Kategorien', 'Neueste Produkte', 'Gesamten Katalog öffnen', 'Katalog wird geladen…', 'Der Live-Katalog ist vorübergehend nicht verfügbar.'],
  es: ['Español', 'Ver catálogo', 'Registrarse en USFans', 'Encuentra productos para pedir con USFans.', 'Explora el catálogo actualizado de CNFansSP y consulta los detalles en la fuente.', 'Buscar productos', 'Buscar', 'Categorías', 'Últimos productos', 'Abrir catálogo completo', 'Cargando catálogo…', 'El catálogo no está disponible temporalmente.'],
  fr: ['Français', 'Voir le catalogue', 'S’inscrire à USFans', 'Trouvez des produits à commander avec USFans.', 'Parcourez le catalogue CNFansSP et consultez les fiches sur le site source.', 'Rechercher des produits', 'Rechercher', 'Catégories', 'Derniers produits', 'Ouvrir le catalogue complet', 'Chargement du catalogue…', 'Le catalogue est temporairement indisponible.'],
  zh: ['简体中文', '浏览目录', '注册 USFans', '挑选适合用 USFans 代购的商品。', '浏览 CNFansSP 实时商品目录，在主站查看商品详情。', '搜索商品', '搜索', '商品分类', '最新商品', '打开完整目录', '正在加载商品目录…', '实时商品目录暂时无法加载。']
};
export function getStaticPaths() {
  const paths = ['', 'catalog', 'categories', 'faq', 'articles', ...articles.map(article => 'articles/' + article.slug)];
  return ['', 'de', 'es', 'fr', 'zh'].flatMap(language => paths.map(page => ({
    params: { path: [language, page].filter(Boolean).join('/') || undefined },
    props: { page, language: language || 'en' },
  })));
}
const { page, language: lang } = Astro.props;
const [language, browse, join, headline, intro, query, search, categories, latest, all, loading, unavailable] = locales[lang];
const labels = {
  en: ['Home', 'Articles', 'View all FAQs', 'View all articles', 'Sources', 'Previous', 'Next', 'Official reference', 'Articles and answers are available in English.'],
  de: ['Start', 'Artikel', 'Alle Fragen', 'Alle Artikel', 'Quellen', 'Zurück', 'Weiter', 'Offizielle Quelle', 'Artikel und Antworten sind auf Englisch verfügbar.'],
  es: ['Inicio', 'Artículos', 'Ver todas las preguntas', 'Ver todos los artículos', 'Fuentes', 'Anterior', 'Siguiente', 'Fuente oficial', 'Los artículos y las respuestas están disponibles en inglés.'],
  fr: ['Accueil', 'Articles', 'Toutes les questions', 'Tous les articles', 'Sources', 'Précédent', 'Suivant', 'Source officielle', 'Les articles et réponses sont disponibles en anglais.'],
  zh: ['首页', '指南文章', '查看全部常见问题', '查看全部文章', '资料来源', '上一页', '下一页', '官方资料', '文章和问答目前提供英文正文。'],
};
const [home, guides, allFaq, allArticles, sources, previous, next, reference, editorialLanguage] = labels[lang];
const pathFor = (path = '', languageCode = lang) => '/' + [languageCode === 'en' ? '' : languageCode, path].filter(Boolean).join('/') + (path || languageCode !== 'en' ? '/' : '');
const article = articles.find(item => page === 'articles/' + item.slug);
const title = article?.title ?? ({ catalog: browse, categories, faq: 'FAQ', articles: guides })[page];
const logo = 'https://media.usfans.com/webresource/v1/app/7f2439bb1554488bb7a14afb3f638c3e.webp';
const source = 'https://www.cnfanssp.com';
---
<!doctype html>
<html lang={lang}>
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><link rel="canonical" href={"https://usfanssheetlist.store" + pathFor(page)}/>{Object.keys(locales).map(code => <link rel="alternate" hreflang={code} href={"https://usfanssheetlist.store" + pathFor(page, code)}/>)}<link rel="icon" href="https://www.usfans.com/favicon.png"/><title>{title ? title + " | USFans Spreadsheet" : "USFans Spreadsheet"}</title><meta name="description" content={article?.summary ?? intro}/></head>
<body>
<header><div class="wrap bar">
  <a class="brand" href={pathFor()} aria-label={home}><img src={logo} alt="USFans" width="106" height="34"/></a>
  <nav aria-label={browse}>
    <a href={pathFor('catalog')} aria-current={page === 'catalog' ? 'page' : undefined}>{browse}</a>
    <a href={pathFor('categories')} aria-current={page === 'categories' ? 'page' : undefined}>{categories}</a>
    <a href={pathFor('faq')} aria-current={page === 'faq' ? 'page' : undefined}>FAQ</a>
    <a href={pathFor('articles')} aria-current={page.startsWith('articles') ? 'page' : undefined}>{guides}</a>
  </nav>
  <div class="actions">
    <details class="languages"><summary>{language}</summary><ul>{Object.entries(locales).map(([code, copy]) => <li><a href={pathFor(page, code)} hreflang={code} aria-current={code === lang ? 'page' : undefined}>{copy[0]}</a></li>)}</ul></details>
    <a class="join" href="https://www.usfans.com/register">{join}</a>
  </div>
</div></header>
<main class="wrap">
  {page === '' && <section class="hero"><div class="intro">
    <h1>USFans Spreadsheet</h1><h2>{headline}</h2><p>{intro}</p>
    <form action={source + '/search.html'} method="get">
      <input type="hidden" name="channelid" value="2"/>
      <input name="keywords" type="search" aria-label={query} placeholder={query} required/>
      <button>{search}</button>
    </form>
  </div></section>}
  {page && !article && <h1 class="page-title">{title}</h1>}
  {['', 'catalog', 'categories'].includes(page) && <p id="status" role="status" data-error={unavailable}>{loading}</p>}
  {['', 'categories'].includes(page) && <section id="categories" hidden>
    {page === '' && <h2>{categories}</h2>}<div class="chips"></div>
  </section>}
  {['', 'catalog'].includes(page) && <section id="catalog">
    <div class="section-heading"><h2>{latest}</h2><a href={source + '/AllProducts/'}>{all}</a></div>
    <div class="grid"></div>
  </section>}
  {page === '' && <div class="home-editorial">
    <section><div class="section-heading"><h2>FAQ</h2><a href={pathFor('faq')}>{allFaq}</a></div>
      <div class="editorial-list" lang="en">{faq.slice(0, 3).map(([question], index) => <a href={pathFor('faq') + '#faq-' + (index + 1)}>{question}</a>)}</div>
    </section>
    <section><div class="section-heading"><h2>{guides}</h2><a href={pathFor('articles')}>{allArticles}</a></div>
      <div class="editorial-list" lang="en">{articles.slice(0, 3).map(item => <a href={pathFor('articles/' + item.slug)}>{item.title}</a>)}</div>
    </section>
  </div>}
  {lang !== 'en' && (page === 'faq' || page.startsWith('articles')) && <p class="editorial-language">{editorialLanguage}</p>}
  {page === 'faq' && <section id="questions">
    <div class="faq-list">{faq.map(([question, answer, url], index) => <details id={'faq-' + (index + 1)}>
      <summary lang="en">{question}</summary><p lang="en">{answer} {url && <a href={url}>{reference}</a>}</p>
    </details>)}</div>
    <div class="pagination" hidden><button id="previous" type="button">{previous}</button><span id="page-number" aria-live="polite"></span><button id="next" type="button">{next}</button></div>
  </section>}
  {page === 'articles' && <div class="article-list" lang="en">{articles.map(item => <a href={pathFor('articles/' + item.slug)}><strong>{item.title}</strong><span>{item.summary}</span></a>)}</div>}
  {article && <article class="reading">
    <a href={pathFor('articles')}>{allArticles}</a>
    <div lang="en"><h1>{article.title}</h1><p class="dek">{article.summary}</p>
      {article.sections.map(([heading, content]) => <section><h2>{heading}</h2><p>{content}</p></section>)}</div>
    <h2>{sources}</h2><ul>{article.sources.map(([url, label]) => <li><a href={url} lang="en">{label}</a></li>)}</ul>
  </article>}
</main>
<footer><div class="wrap"><strong>USFans Spreadsheet</strong><a href={source}>CNFansSP</a></div></footer>
<script is:inline>
  const status = document.querySelector('#status');
  function add(parent, tag, value) {
    const node = document.createElement(tag);
    if (value) node.textContent = value;
    parent.append(node);
    return node;
  }
  async function showCatalog() {
    const response = await fetch('/catalog.json');
    if (!response.ok) throw new Error('Catalog unavailable');
    const catalog = await response.json();
    const chips = document.querySelector('.chips');
    const productGrid = document.querySelector('.grid');
    for (const category of chips ? catalog.categories : []) {
      add(chips, 'a', category.name).href = category.url;
    }
    for (const item of productGrid ? catalog.products : []) {
      const card = add(productGrid, 'a');
      card.href = item.url;
      if (item.image) {
        const image = add(card, 'img');
        image.src = item.image;
        image.alt = '';
        image.loading = 'lazy';
        image.addEventListener('error', () => image.remove(), { once: true });
      }
      const copy = add(card, 'div');
      add(copy, 'strong', item.name);
      add(copy, 'small', item.price);
    }
    if (chips) document.querySelector('#categories').hidden = catalog.categories.length === 0;
    status.hidden = true;
  }
  if (status) showCatalog().catch(() => { status.textContent = status.dataset.error; });

  const questions = Array.from(document.querySelectorAll('.faq-list details'));
  if (questions.length) {
    const size = 6;
    const pageCount = Math.ceil(questions.length / size);
    const previous = document.querySelector('#previous');
    const next = document.querySelector('#next');
    let index = 0;
    function showPage() {
      questions.forEach((question, position) => { question.hidden = Math.floor(position / size) !== index; });
      document.querySelector('#page-number').textContent = (index + 1) + ' / ' + pageCount;
      previous.disabled = index === 0;
      next.disabled = index === pageCount - 1;
    }
    function openHash() {
      const selected = questions.findIndex(question => '#' + question.id === location.hash);
      if (selected >= 0) {
        index = Math.floor(selected / size);
        questions[selected].open = true;
      }
      showPage();
    }
    previous.addEventListener('click', () => { index -= 1; showPage(); });
    next.addEventListener('click', () => { index += 1; showPage(); });
    window.addEventListener('hashchange', openHash);
    openHash();
    document.querySelector('.pagination').hidden = false;
  }
</script>
</body>
</html>
<style is:inline>
:root{font-family:system-ui,sans-serif;color:#171e18;background:#f8f9f5;--accent:#dafa72;--rule:#dde1d8}
*{box-sizing:border-box}body{margin:0}a{color:inherit;text-decoration:none}a:hover{text-decoration:underline}button,summary{cursor:pointer}.wrap{width:min(1180px,calc(100% - 48px));margin-inline:auto}
header{background:#fff;border-bottom:1px solid var(--rule)}.bar,nav,.section-heading,footer .wrap{display:flex;align-items:center;justify-content:space-between;gap:20px}.bar{min-height:72px}.brand{font-weight:850;letter-spacing:-.04em;font-size:1.18rem}.brand span{color:#496a22}.join,summary{display:block;border:1px solid var(--rule);padding:9px 13px;border-radius:8px;font-size:.9rem}.join{background:var(--accent);border-color:transparent;font-weight:700}.languages{position:relative}.languages ul{position:absolute;right:0;z-index:2;min-width:140px;margin:6px 0 0;padding:8px;background:white;border:1px solid var(--rule);border-radius:8px;list-style:none}.languages a{display:block;padding:6px}.languages [aria-current]{font-weight:800}
.hero{margin:30px 0 34px;padding:clamp(30px,7vw,85px);background:#203527;color:#fff;border-radius:22px;background-image:linear-gradient(120deg,#203527 56%,#2a4936)}.intro{max-width:760px}.hero h1{margin:0 0 14px;color:var(--accent);font-size:clamp(2.25rem,7vw,5.4rem);line-height:.99;letter-spacing:-.065em}.hero h2{font-size:clamp(1.1rem,2.7vw,1.65rem);margin:0}.hero p{color:#e0eade;margin:10px 0 26px}
form{display:flex;gap:5px;background:#fff;padding:5px;border-radius:9px;max-width:570px}input,button{font:inherit;border:0;border-radius:6px}input{width:100%;min-width:0;padding:12px;background:white;color:#171e18}button{background:var(--accent);color:#172016;font-weight:750;padding:10px 17px}
section h2{letter-spacing:-.025em}.chips{display:flex;flex-wrap:wrap;gap:8px}.chips a{padding:7px 12px;background:white;border:1px solid var(--rule);border-radius:7px}.section-heading{margin-top:23px}.section-heading a{font-size:.9rem;text-decoration:underline}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px}.grid a{overflow:hidden;border:1px solid var(--rule);border-radius:12px;background:white}.grid img{display:block;width:100%;aspect-ratio:1.18;object-fit:contain;background:#f1f2ee}.grid a div{padding:13px;overflow-wrap:anywhere}.grid small{display:block;margin-top:7px;color:#435748}footer{margin-top:40px;padding:23px 0;border-top:1px solid var(--rule)}
@media(max-width:700px){.wrap{width:calc(100% - 28px)}.browse{display:none}.bar,nav{gap:7px}.brand{font-size:1rem}.join,summary{padding:7px;font-size:.82rem}.hero{margin-top:14px;padding:30px 18px}.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}}

.brand img{display:block;object-fit:contain;object-position:left center}.actions{display:flex;align-items:center;gap:8px}nav [aria-current]{text-decoration:underline;text-underline-offset:5px}.page-title{margin:30px 0 16px;letter-spacing:-.04em}.home-editorial{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.editorial-list,.article-list,.faq-list{display:grid;gap:8px}.editorial-list a,.article-list a,.faq-list details{border:1px solid var(--rule);border-radius:9px;background:white;padding:12px 14px}.article-list a{display:grid;gap:4px}.article-list span,.editorial-language,.reading .dek{color:#435748}.article-list{grid-template-columns:repeat(2,minmax(0,1fr))}.faq-list summary{border:0;padding:0;display:list-item;font-size:1rem;font-weight:650}.faq-list p{margin:12px 0 0;line-height:1.5}.faq-list a,.reading a{text-decoration:underline;text-underline-offset:3px}.pagination{display:flex;align-items:center;gap:12px;margin-top:15px}.pagination[hidden],.faq-list [hidden]{display:none}.pagination button:disabled{opacity:.45;cursor:default}.reading{max-width:740px;margin:32px auto;line-height:1.55}.reading h1{font-size:clamp(1.8rem,5vw,3rem);letter-spacing:-.05em;line-height:1.08;margin:14px 0}.reading h2{font-size:1.2rem;margin-bottom:5px}.reading p{margin:4px 0 16px}.reading ul{padding-left:20px}
@media(max-width:700px){.bar{display:grid;grid-template-columns:auto 1fr;row-gap:6px;min-height:0;padding-top:8px}.actions{justify-self:end}.bar nav{grid-row:2;grid-column:1/-1;justify-content:flex-start;flex-wrap:wrap;gap:6px 14px;padding:6px 0 10px;font-size:.9rem}.brand img{width:86px;height:30px}.home-editorial,.article-list{grid-template-columns:1fr;gap:7px}.grid a:nth-child(n+7){display:none}.page-title{margin:19px 0 12px}.reading{margin:19px 0}.hero{margin-bottom:20px}.section-heading{margin-top:12px}.editorial-list a,.article-list a,.faq-list details{padding:9px 12px}}
</style>
