---
import Header from '../components/Header.astro'
import { editorialLabels, locales, localePath } from '../locales.mjs'
import { articles, faq, sources } from '../editorial.mjs'

export function getStaticPaths() {
  const sections = ['faq', 'guides', ...articles.map(article => 'guides/' + article.slug)]
  return Object.keys(locales).flatMap(lang => sections.map(section => ({
    params: { editorial: (lang === 'en' ? '' : lang.toLowerCase() + '/') + section },
    props: { lang, section },
  })))
}
const { lang, section } = Astro.props
const labels = editorialLabels[lang]
const root = localePath(lang)
const isFaq = section === 'faq'
const article = articles.find(item => section === 'guides/' + item.slug)
const title = article?.title ?? (isFaq ? labels.faq : labels.articles)
const lookup = Object.fromEntries(articles.map(item => [item.slug, item]))
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" href="https://www.usfans.com/favicon.png" />
  <title>{title} | USFans Spreadsheet</title>
  {article && <meta name="description" content={article.intro} />}
</head>
<body>
  <Header lang={lang} section={section + '/'} />
  <main class="wrap reading">
    <div class="back"><a href={article ? root + 'guides/' : root}>{article ? labels.articles : labels.home}</a></div>
    <h1 lang={article ? 'en' : undefined}>{title}</h1>
    {labels.languageNote && <p class="language-note">{labels.languageNote}</p>}
    {isFaq ? (
      <div class="faq" lang="en">
        {faq.map(([question, answer, slug], index) => (
          <details name="faq" id={'q-' + (index + 1)}>
            <summary>{question}</summary>
            <p>{answer}</p>
            <a href={root + 'guides/' + slug + '/'}>{lookup[slug].title}</a>
          </details>
        ))}
      </div>
    ) : article ? (
      <article lang="en">
        <p class="intro">{article.intro}</p>
        {article.sections.map(([heading, body]) => <section><h2>{heading}</h2><p>{body}</p></section>)}
        <aside aria-label={labels.sources}>
          <h2>{labels.sources}</h2>
          <ul>{article.refs.map(ref => <li><a href={sources[ref][1]}>{sources[ref][0]}</a></li>)}</ul>
        </aside>
      </article>
    ) : (
      <ul class="guide-list" lang="en">
        {articles.map(item => <li><a href={root + 'guides/' + item.slug + '/'}><strong>{item.title}</strong><span>{item.intro}</span></a></li>)}
      </ul>
    )}
  </main>
  <footer><div class="wrap">USFans Spreadsheet · {locales[lang].independent}</div></footer>
  {isFaq && <script is:inline>
    function openLinkedQuestion() {
      if (!/^#q-\d+$/.test(location.hash)) return;
      const item = document.getElementById(location.hash.slice(1));
      if (item instanceof HTMLDetailsElement) {
        item.open = true;
        item.scrollIntoView({block:'nearest'});
      }
    }
    openLinkedQuestion();
    addEventListener('hashchange', openLinkedQuestion);
  </script>}
</body>
</html>
<style is:global>
  :root { color-scheme:light; font-family:Inter,system-ui,sans-serif; color:#24211a; background:#f8f7f2; --line:#e5e0d4; --accent:#ffdb55; }
  * { box-sizing:border-box; }
  body { margin:0; }
  a { color:inherit; text-underline-offset:.2em; }
  a:focus-visible, summary:focus-visible { outline:3px solid #927100; outline-offset:3px; }
  .site-header a { text-decoration:none; }
  .wrap { width:min(1152px, calc(100% - 44px)); margin-inline:auto; }
  .reading { max-width:730px; padding:27px 0 36px; }
  .back { font-size:.9rem; font-weight:650; }
  h1 { font-size:clamp(2rem,5vw,3.55rem); margin:12px 0 18px; line-height:1.07; letter-spacing:-.045em; }
  h2 { font-size:1.13rem; line-height:1.28; margin:18px 0 4px; }
  p { font-size:1rem; line-height:1.53; margin:0 0 8px; }
  .intro, .language-note { color:#645940; margin-bottom:14px; }
  .language-note { font-size:.9rem; }
  .faq, .guide-list { border-top:1px solid var(--line); }
  .faq details, .guide-list li { border-bottom:1px solid var(--line); }
  .faq details { scroll-margin-top:10px; }
  .faq summary { padding:9px 0; cursor:pointer; font-weight:650; line-height:1.3; }
  .faq details p, .faq details a { margin-inline-start:17px; }
  .faq details a { display:inline-block; margin-block:1px 10px; }
  .guide-list, aside ul { margin:0; padding:0; list-style:none; }
  .guide-list a { display:block; padding:9px 0; text-decoration:none; }
  .guide-list a:hover strong { text-decoration:underline; }
  .guide-list span { display:block; font-size:.9rem; color:#665f53; line-height:1.35; margin-top:3px; }
  aside { margin-top:16px; padding-top:4px; border-top:1px solid var(--line); }
  aside ul { display:flex; flex-wrap:wrap; gap:4px 12px; font-size:.88rem; }
  footer { padding:15px 0; border-top:1px solid var(--line); color:#665f53; font-size:.875rem; }
  @media(max-width:700px) {
    .wrap { width:calc(100% - 28px); }
    .reading { padding-block:18px 24px; }
    h1 { margin-bottom:12px; }
  }
</style>
