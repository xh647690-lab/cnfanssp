---
import Header from './Header.astro'
import { faq, articles } from '../editorial.mjs'
import { locales, localePath, editorialLabels } from '../locales.mjs'
const { lang } = Astro.props
const t = locales[lang]
const labels = editorialLabels[lang]
const root = localePath(lang)
const latestFaq = faq.slice(-3).reverse()
const latestArticles = articles.slice(-3).reverse()
const main = 'https://www.cnfanssp.com'
const all = main + '/AllProducts/'
const sorted = (sort) => main + '/index.php?' + new URLSearchParams({m:'home',c:'Lists',a:'index',tid:'1',sort,sort_asc:'desc',ZXljbXM:'1'})
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={t.intro} />
  <link rel="icon" href="https://www.usfans.com/favicon.png" />
  <title>{t.title}</title>
  {Object.keys(locales).map(code => <link rel="alternate" hreflang={code} href={'https://usfanspicks.shop' + localePath(code)} />)}
</head>
<body>
<Header lang={lang} />
<main class="wrap">
  <section class="hero">
    <div class="hero-inner">
      <h1>{t.title}</h1>
      <p>{t.intro}</p>
      <form action={main + '/search.html'} method="get" role="search">
        <input type="hidden" name="channelid" value="2" />
        <input required type="search" name="keywords" aria-label={t.placeholder} placeholder={t.placeholder} />
        <button type="submit">{t.search}</button>
      </form>
      <a class="browse" href={all}>{t.browse}</a>
    </div>
  </section>
  <section id="categories">
    <h2>{t.categories}</h2>
    <div class="chips" set:html={'<!-- live-categories -->'} />
  </section>
  <section id="latest">
    <div class="section-head">
      <div><h2>{t.latest}</h2><p>{t.source}</p></div>
      <div class="sorting"><a href={sorted('click')}>{t.popular}</a><a href={sorted('price')}>{t.price}</a></div>
    </div>
    <div class="products" set:html={'<!-- live-products -->'} />
    <a class="all" href={all}>{t.browse}</a>
  </section>
  <section class="editorial-home" aria-label={labels.articles}>
    <div>
      <h2>{labels.latestFaq}</h2>
      <div class="mini-cards" lang="en">
        {latestFaq.map(([title], index) => <a href={root + 'faq/#q-' + (faq.length - index)}>{title}</a>)}
      </div>
      <a class="all" href={root + 'faq/'}>{labels.allFaq}</a>
    </div>
    <div>
      <h2>{labels.latestArticles}</h2>
      <div class="mini-cards" lang="en">
        {latestArticles.map(article => <a href={root + 'guides/' + article.slug + '/'}>{article.title}</a>)}
      </div>
      <a class="all" href={root + 'guides/'}>{labels.allArticles}</a>
    </div>
  </section>
</main>
<footer><div class="wrap bar"><strong>USFans Spreadsheet</strong><span>{t.independent} · <a href={main}>cnfanssp.com</a></span></div></footer>
</body>
</html>

<style is:global>
  :root { color-scheme: light; font-family: Inter, system-ui, sans-serif; color: #24211a; background: #f8f7f2; --line: #e5e0d4; --accent: #ffdb55; }
  * { box-sizing: border-box; }
  body { margin: 0; }
  a { color: inherit; text-decoration: none; }
  a:hover { text-decoration: underline; }
  a:focus-visible, summary:focus-visible, button:focus-visible, input:focus-visible { outline: 3px solid #927100; outline-offset: 4px; }
  .wrap { width: min(1152px, calc(100% - 56px)); margin-inline: auto; }
  header { background: #fffdf8; border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 72px; }
  .hero { margin-top: 30px; border-radius: 21px; padding: clamp(30px, 5vw, 66px); background: linear-gradient(115deg,#221f17,#3b3018); color: #fff9e6; }
  .hero-inner { max-width: 725px; }
  h1 { margin: 0; font-size: clamp(2.15rem, 6vw, 4.7rem); letter-spacing: -.067em; line-height: 1.02; }
  .hero p { color: #e2d8bc; margin: 18px 0 25px; font-size: 1.05rem; line-height: 1.6; }
  form { display: flex; max-width: 605px; padding: 5px; gap: 6px; border-radius: 12px; background: #fffdf8; }
  input { min-width: 0; flex: 1; padding: 10px; border: 0; border-radius: 8px; background: transparent; font: inherit; }
  button { cursor: pointer; padding: 11px 16px; border: 0; border-radius: 8px; background: var(--accent); color: #241e11; font: inherit; font-weight: 750; }
  .browse { display: inline-block; margin-top: 18px; color: #ffe38a; font-weight: 650; }
  section + section { margin-top: 32px; }
  h2 { margin: 0 0 11px; letter-spacing: -.035em; font-size: 1.75rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chips a, .sorting a { border: 1px solid var(--line); border-radius: 8px; background: #fffdf8; padding: 8px 12px; font-size: .9rem; font-weight: 630; }
  .section-head { display: flex; align-items: end; justify-content: space-between; gap: 10px; margin-bottom: 15px; }
  .section-head h2 { margin: 0 0 4px; }
  .section-head p { margin: 0; color: #6a6050; font-size: .9rem; }
  .sorting { display:flex; gap:5px; }
  .products { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 14px; }
  .card { overflow: hidden; border: 1px solid var(--line); border-radius: 13px; background: #fffdf8; }
  .picture { display: block; background: #eee9dc; aspect-ratio: 5/4; overflow: hidden; }
  .picture img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .card-body { padding: 11px 13px 14px; }
  .card h3 { margin: 0 0 5px; font-size: 1rem; overflow-wrap: anywhere; }
  .price { margin: 0 0 9px; color: #5c4a17; font-weight: 750; }
  .card-actions { display: flex; flex-wrap: wrap; gap: 6px 11px; font-size: .875rem; font-weight: 650; }
  .card-actions a { text-decoration: underline; text-underline-offset: .17em; }
  .all { display: inline-block; margin: 18px 0 30px; padding: 10px 14px; border: 1px solid var(--line); border-radius: 8px; font-weight: 700; }
  footer { background: #fffdf8; border-top: 1px solid var(--line); }
  footer span { color: #655c4d; font-size: .9rem; }
  footer a { text-decoration: underline; }
  .editorial-home { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-top:5px; }
  .mini-cards { display:grid; gap:6px; }
  .mini-cards a { display:block; padding:9px 12px; background:#fffdf8; border:1px solid var(--line); border-radius:8px; font-size:.93rem; font-weight:650; }
  .error { grid-column: 1/-1; }
  @media(max-width: 720px) {
    .editorial-home { grid-template-columns:1fr; gap:0; }
    .wrap { width: calc(100% - 28px); }
    .bar { min-height: 60px; gap: 10px; }
    .hero { margin-top: 14px; padding: 28px 17px; }
    .hero p { margin: 12px 0 18px; }
    h2 { font-size: 1.4rem; }
    .products { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 8px; }
    .picture { aspect-ratio: 4/3; }
    .card-body { padding: 9px; }
    .chips a, .sorting a { padding: 6px 8px; }
    footer .bar { padding-block: 16px; align-items: start; flex-direction: column; }
  }
</style>
