---
import { origin, catalogUrl, products } from '../lib/catalog.js';
import { copyFor, languages, languagePath } from '../lib/languages.js';
import { articles, faqs, official } from '../lib/editorial.js';

export function getStaticPaths() {
  const pages = ['','categories','spreadsheet','faq','guides', ...articles.map(article => 'guides/' + article.slug)];
  return Object.keys(languages).flatMap(lang => pages.map(page => {
    const path = [lang === 'en' ? '' : lang, page].filter(Boolean).join('/');
    return { params: { route: path || undefined }, props: { lang, page } };
  }));
}

const { lang, page } = Astro.props;
const t = copyFor(lang);
const labels = {
  en: ['Spreadsheet','FAQ','Buying guides','See all','Read the guide','Sources','English article'],
  zh: ['商品表','常见问题','购买指南','查看全部','阅读指南','资料来源','正文为英语'],
  de: ['Produktliste','FAQ','Kaufratgeber','Alle ansehen','Ratgeber lesen','Quellen','Artikel auf Englisch'],
  es: ['Catálogo','Preguntas frecuentes','Guías de compra','Ver todo','Leer guía','Fuentes','Artículo en inglés'],
  fr: ['Catalogue','Questions fréquentes','Guides d’achat','Tout voir','Lire le guide','Sources','Article en anglais'],
}[lang];
const [sheet, faq, guides, seeAll, readGuide, sources, english] = labels;
const link = (pagePath = '', locale = lang) => languagePath(locale) + (pagePath ? pagePath + '/' : '');
const article = page.startsWith('guides/') ? articles.find(entry => page === 'guides/' + entry.slug) : undefined;
const heading = ({ categories: t.categories, spreadsheet: sheet, faq, guides })[page];
const title = article?.title ?? (heading ? 'HipoBuy ' + heading : 'HipoBuy Spreadsheet');
const categories = [
  ['shoes', '/shoes/'], ['hoodies', '/hoodies-sweaters/'], ['tees', '/t-shirts/'],
  ['jackets', '/jackets/'], ['bottoms', '/pants-shorts/'], ['accessories', '/accessories/'],
  ['headwear', '/headwear/'], ['jersey', '/Jersey/'], ['electronics', '/electronics/'], ['other', '/other-stuff/'],
];
const categoryLabels = {
  en: ['Headwear', 'Jerseys', 'Electronics', 'Other'],
  zh: ['帽饰', '球衣', '电子产品', '其他'],
  de: ['Kopfbedeckung', 'Trikots', 'Elektronik', 'Sonstiges'],
  es: ['Gorras y sombreros', 'Camisetas deportivas', 'Electrónica', 'Otros'],
  fr: ['Couvre-chefs', 'Maillots', 'Électronique', 'Autres'],
}[lang];
const localizedContent = !article && page !== 'faq' && page !== 'guides';
const canonical = new URL(link(page, localizedContent ? lang : 'en'), Astro.site).href;
const measurementId = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID;
const analyticsEnabled = /^G-[A-Z0-9]+$/.test(measurementId ?? '');
const logo = '/hipobuy-logo.png';
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-Hans' : lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="canonical" href={canonical} />
    {localizedContent && Object.keys(languages).map(code => (
      <link rel="alternate" hreflang={code === 'zh' ? 'zh-Hans' : code} href={new URL(link(page, code), Astro.site).href} />
    ))}
    {analyticsEnabled && <script is:inline async src={'https://www.googletagmanager.com/gtag/js?id=' + measurementId}></script>}
    {analyticsEnabled && <script define:vars={{ measurementId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', measurementId);
    </script>}
    <meta name="description" content={article?.summary ?? t.intro} />
    <link rel="icon" type="image/png" href="/hipobuy-icon.png" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <div class="bar shell">
        <a class="brand" href={link()} aria-label="HipoBuy Spreadsheet"><img src={logo} alt="HipoBuy" width="110" height="34" /></a>
        <nav aria-label={t.home}>
          {[[sheet, 'spreadsheet'], [t.categories, 'categories'], [faq, 'faq'], [guides, 'guides']].map(([label, route]) => (
            <a href={link(route)} aria-current={page === route ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
        <details class="language">
          <summary aria-label={t.language}>{languages[lang]}</summary>
          <ul>{Object.entries(languages).map(([code, label]) => (
            <li><a href={link(page, code)} lang={code} aria-current={code === lang ? 'page' : undefined}>{label}</a></li>
          ))}</ul>
        </details>
      </div>
    </header>
    <main class="shell">
      {!page && <section class="hero">
        <h1>HipoBuy<br />Spreadsheet</h1>
        <p>{t.intro}</p>
        <form action={origin + '/search.html'} method="get" role="search">
          <input required type="search" name="keywords" placeholder={t.placeholder} aria-label={t.search} />
          <input type="hidden" name="channelid" value="2" />
          <button type="submit">{t.search}</button>
        </form>
      </section>}
      {page && !article && <h1 class="page-title">{title}</h1>}
      {(!page || page === 'categories') && <section aria-labelledby={page ? undefined : 'categories-title'}>
        {!page && <div class="section-heading"><h2 id="categories-title">{t.categories}</h2><a href={link('categories')}>{seeAll}</a></div>}
        <div class="categories">
          {categories.slice(0, page ? categories.length : 6).map(([label, path], index) => <a href={origin + path}>{t[label] ?? categoryLabels[index - 6]}</a>)}
        </div>
      </section>}
      {(!page || page === 'spreadsheet') && <section aria-labelledby="latest-title">
        {page && <form class="catalog-search" action={origin + '/search.html'} method="get" role="search">
          <input required type="search" name="keywords" placeholder={t.placeholder} aria-label={t.search} />
          <input type="hidden" name="channelid" value="2" />
          <button type="submit">{t.search}</button>
        </form>}
        <div class="section-heading"><h2 id="latest-title">{t.latest}</h2><a href={catalogUrl}>{t.all}</a></div>
        <div class="products">
          {products.slice(0, page ? 8 : 4).map(product => (
            <a class="product" href={product.url}>
              <img src={product.image} alt="" loading="lazy" width="320" height="240" />
              <div><strong>{product.name}</strong><span>{t.details}</span></div>
            </a>
          ))}
        </div>
      </section>}
      {(!page || page === 'faq') && <section>
        {!page && <div class="section-heading"><h2>{faq}</h2><a href={link('faq')}>{seeAll}</a></div>}
        {lang !== 'en' && <p class="locale-note">{english}</p>}
        <div class={page ? 'faq-list' : 'cards'} lang="en">
          {faqs.slice(0, page ? faqs.length : 3).map(({ id, question, answer, guide }) => page ? (
            <details id={id} class="faq-row">
              <summary>{question}</summary>
              <div><p>{answer}</p><a href={link('guides/' + guide)}>{readGuide}</a></div>
            </details>
          ) : <a class="card" href={link('faq') + '#' + id}>{question}</a>)}
        </div>
      </section>}
      {(!page || page === 'guides') && <section>
        {!page && <div class="section-heading"><h2>{guides}</h2><a href={link('guides')}>{seeAll}</a></div>}
        {lang !== 'en' && <p class="locale-note">{english}</p>}
        <div class={page ? 'guide-list' : 'cards'} lang="en">
          {articles.slice(0, page ? articles.length : 3).map(entry => (
            <a class="card" href={link('guides/' + entry.slug)}><strong>{entry.title}</strong>{page && <span>{entry.summary}</span>}</a>
          ))}
        </div>
      </section>}
      {article && <article>
        <a href={link('guides')}>{guides}</a>
        {lang !== 'en' && <p class="locale-note">{english}</p>}
        <div lang="en">
          <h1 class="page-title">{article.title}</h1>
          <p class="intro">{article.summary}</p>
          {article.sections.map(([name, paragraph]) => <section><h2>{name}</h2><p>{paragraph}</p></section>)}
        </div>
        <section class="sources"><h2>{sources}</h2><ul>{article.sources.map(source => <li><a href={source}>{new URL(source).hostname}</a></li>)}</ul></section>
      </article>}
    </main>
    <footer class="shell"><a href={origin}>{t.source}</a><a href={official}>HipoBuy.com</a></footer>
  </body>
</html>

<style is:global>
  :root{font-family:system-ui,sans-serif;color:#172c25;background:#f6f7f1;font-synthesis:none;--line:#d6e1d6;--green:#175840}
  *{box-sizing:border-box} body{margin:0} a{color:inherit;text-decoration:none} a:hover{text-decoration:underline}
  :focus-visible{outline:3px solid #39835c;outline-offset:3px}
  .shell{width:min(1120px,calc(100% - 36px));margin-inline:auto}
  header{border-bottom:1px solid var(--line);background:#fcfdf8}
  .bar{display:flex;align-items:center;gap:24px;min-height:74px}
  .brand{display:flex;align-items:center;gap:8px;font-weight:750;white-space:nowrap}
  .mark{display:grid;place-items:center;width:34px;height:34px;border-radius:10px;background:var(--green);color:white}
  .brand-detail{font-weight:500;color:#51665a}
  nav{display:flex;gap:20px;margin-left:auto;font-size:.9rem}
  .language{margin-left:auto;position:relative;font-size:.875rem}
  summary{cursor:pointer;border:1px solid var(--line);border-radius:9px;padding:9px 11px;white-space:nowrap}
  .language ul{position:absolute;z-index:1;right:0;min-width:144px;background:white;list-style:none;border:1px solid var(--line);padding:5px;margin-top:6px;border-radius:10px}
  .language a{display:block;padding:8px;border-radius:5px}.language a[aria-current]{background:#e5f2de}
  .hero{margin-top:26px;padding:clamp(23px,5vw,62px);border-radius:22px;background:#133e32;color:#f7fff5;background-image:radial-gradient(ellipse at top right,#2c674a,transparent 60%)}
  h1,h2,p{margin:0}
  h1{font-size:clamp(2.65rem,7vw,6rem);line-height:.95;letter-spacing:-.055em;font-weight:780}
  .hero p{margin-top:20px;max-width:37rem;color:#dbeade;line-height:1.5}
  form{display:flex;gap:6px;max-width:590px;margin-top:23px;background:white;border-radius:12px;padding:5px}
  input[type=search]{min-width:0;flex:1;border:0;border-radius:6px;padding:9px;font:inherit;color:#172c25}
  button{border:0;border-radius:8px;background:#d8efaa;color:#152d1c;padding:10px 15px;cursor:pointer;font:inherit;font-weight:700}
  main>section+section{margin-top:29px} h2{font-size:clamp(1.3rem,3vw,1.8rem);letter-spacing:-.035em}
  .categories,.products{display:grid;gap:10px;margin-top:12px}
  .categories{grid-template-columns:repeat(6,minmax(0,1fr))}
  .categories a{border:1px solid var(--line);border-radius:10px;background:#fff;padding:13px 9px;text-align:center;font-weight:650}
  .section-heading{display:flex;align-items:baseline;justify-content:space-between;gap:12px}
  .section-heading a,footer a{color:var(--green);font-size:.875rem}
  .products{grid-template-columns:repeat(4,minmax(0,1fr))}
  .product{overflow:hidden;border-radius:12px;border:1px solid var(--line);background:white}
  .product img{width:100%;height:auto;aspect-ratio:4/3;object-fit:contain;display:block;background:#eaf0e7}
  .product div{padding:11px;display:grid;gap:3px}.product span{font-size:.875rem;color:var(--green)}
  footer{margin-top:34px;padding:15px 0 26px;border-top:1px solid var(--line)}
  @media(max-width:720px){.bar{gap:10px;min-height:60px}.brand-detail,nav{display:none}.hero{margin-top:15px}.categories{grid-template-columns:repeat(3,minmax(0,1fr))}.products{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
<style is:global>
  .brand img{display:block;width:110px;height:34px;object-fit:contain;object-position:left center}
  .bar nav a[aria-current]{text-decoration:underline;text-underline-offset:4px}
  footer{display:flex;justify-content:space-between;gap:12px}
  .page-title{font-size:clamp(2.1rem,5vw,4.3rem);line-height:1.04;margin:31px 0 19px}
  .cards,.guide-list,.faq-list{display:grid;gap:9px;margin-top:12px}
  .cards{grid-template-columns:repeat(3,1fr)}
  .guide-list,.faq-list{grid-template-columns:repeat(2,minmax(0,1fr));align-items:start}
  .card,.faq-row{background:#fff;border:1px solid var(--line);border-radius:10px}
  .card{display:grid;gap:4px;padding:12px;font-weight:650;line-height:1.32}
  .card span,.locale-note{font-weight:400;color:#51665a;font-size:.9rem}
  .locale-note{margin:8px 0}
  .faq-row summary{border:0;border-radius:9px;white-space:normal;font-weight:620;padding:10px 12px}
  .faq-row div{padding:0 12px 12px;line-height:1.5}
  .faq-row div a,article a{color:var(--green);text-decoration:underline;text-underline-offset:3px}
  .faq-row:target{outline:2px solid var(--green);scroll-margin-top:14px}
  article{max-width:740px;margin:23px auto 0;line-height:1.55}
  article .page-title{margin:12px 0}
  article .intro{font-size:1.08rem;color:#51665a}
  article section{margin-top:20px}
  article h2{margin-bottom:4px}
  article ul{margin:5px 0;padding-left:22px}
  .catalog-search{margin:0 0 16px}
  @media(max-width:720px){
    .bar{display:grid;grid-template-columns:1fr auto;gap:6px;padding:8px 0}
    .bar nav{display:flex;grid-column:1/-1;grid-row:2;margin:0;gap:0;justify-content:space-between;flex-wrap:wrap}
    .bar nav a{padding:5px 4px;font-size:.875rem}
    .cards,.guide-list,.faq-list{grid-template-columns:1fr}
    .card{padding:9px 11px}
    .faq-row summary{padding:8px 10px;font-size:.94rem}
    article section{margin-top:16px}
  }
</style>
<script>
  function revealQuestion() {
    const id = location.hash.slice(1);
    const question = document.getElementById(id);
    if (question instanceof HTMLDetailsElement) question.open = true;
  }
  revealQuestion();
  window.addEventListener('hashchange', revealQuestion);
</script>
